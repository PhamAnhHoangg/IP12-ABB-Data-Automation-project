    {
      "id": "l4",
      "name": "Build report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        480
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Turn the JSONL data file (written by the Python code) into a Markdown report.\nconst text = $input.first().json.data || '';\nconst rows = [];\nlet bad = 0;\nfor (const line of text.split(/\\r?\\n/)) {\n  if (!line.trim()) continue;\n  try {\n    const o = JSON.parse(line);\n    // accept single objects or batches {detections:[...]}\n    if (Array.isArray(o.detections)) for (const d of o.detections) rows.push({ run_code: o.run_code, model_version: o.model_version, timestamp: o.timestamp, ...d });\n    else rows.push(o);\n  } catch (e) { bad++; }\n}\n\nconst LOW = 0.6;\nconst n = rows.length;\nconst conf = rows.map(r => Number(r.confidence)).filter(c => !isNaN(c));\nconst avg = conf.length ? conf.reduce((a, b) => a + b, 0) / conf.length : 0;\nconst low = conf.filter(c => c < LOW).length;\nconst countBy = key => {\n  const m = {};\n  for (const r of rows) { const k = r[key] ?? '—'; m[k] = (m[k] || 0) + 1; }\n  return Object.entries(m).sort((a, b) => b[1] - a[1]);\n};\nconst table = (title, pairs) => pairs.length\n  ? `### ${title}\\n\\n| ${title} | Count | Share |\\n|---|---:|---:|\\n` +\n    pairs.map(([k, v]) => `| ${k} | ${v} | ${n ? Math.round(v / n * 100) : 0}% |`).join('\\n') + '\\n'\n  : '';\nconst times = rows.map(r => r.timestamp).filter(Boolean).sort();\nconst now = $now.setZone('Europe/Berlin');\n\nlet md = `# IP12 Data Report\\n\\nGenerated ${now.toFormat('dd.LL.yyyy HH:mm')} by n8n from \\`shared/detections.jsonl\\`.\\n\\n`;\nmd += `## Summary\\n\\n| Metric | Value |\\n|---|---:|\\n`;\nmd += `| Detections | ${n} |\\n| Test runs | ${countBy('run_code').length} |\\n`;\nmd += `| Average confidence | ${conf.length ? avg.toFixed(2) : '—'} |\\n`;\nmd += `| Low confidence (< ${LOW}) | ${low} (${n ? Math.round(low / n * 100) : 0}%) |\\n`;\nif (times.length) md += `| First / last record | ${times[0]} / ${times[times.length - 1]} |\\n`;\nif (bad) md += `| Unreadable lines skipped | ${bad} |\\n`;\nmd += '\\n' + table('Color', countBy('color')) + '\\n' + table('Class', countBy('class')) + '\\n' +\n      table('Priority', countBy('priority')) + '\\n' + table('Model version', countBy('model_version')) + '\\n' +\n      table('Run', countBy('run_code'));\n\nreturn [{ json: { md, detections: n, avg_confidence: Number(avg.toFixed(3)), low_confidence: low, file_name: `ip12-report-${now.toFormat('yyyy-LL-dd')}.md` } }];\n"
      }
    },
